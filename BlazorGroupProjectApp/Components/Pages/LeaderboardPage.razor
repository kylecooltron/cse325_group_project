@page "/leaderboard"
@attribute [Authorize]
@inject BlazorGroupProjectApp.Services.LeaderboardService LeaderboardService

<PageTitle>Leaderboard - ClimateSeer</PageTitle>

<h1>Leaderboard</h1>

@if (errorMessage != null)
{
    <p role="alert" style="color:red;">@errorMessage</p>
}
else if (entries == null)
{
    <p>Loading leaderboard...</p>
}
else if (!entries.Any())
{
    <p>No scores yet this month.</p>
}
else
{
    <LeaderboardTable Entries="entries" />
}

@code {
    private List<BlazorGroupProjectApp.Models.LeaderboardEntry>? entries;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            entries = await LeaderboardService.GetCurrentMonthLeaderboardAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Could not load the leaderboard. Please try refreshing the page.";
            _ = ex;
        }
    }
}
