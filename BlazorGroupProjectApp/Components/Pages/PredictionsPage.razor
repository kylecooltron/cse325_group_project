@page "/predictions"
@attribute [Authorize]
@rendermode InteractiveServer
@inject BlazorGroupProjectApp.Services.PredictionService PredictionService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Predictions - ClimateSeer</PageTitle>

<div class="page-header">
    <h1>My Predictions</h1>
    <a href="/predictions/new" class="btn-new-prediction">+ New Prediction</a>
</div>

@if (predictions == null)
{
    <p>Loading predictions...</p>
}
else if (!predictions.Any())
{
    <p>No predictions yet. Make your first one!</p>
}
else
{
    <PredictionList Predictions="predictions" />
}

@code {
    private List<BlazorGroupProjectApp.Models.Prediction>? predictions;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
            predictions = await PredictionService.GetUserPredictionsAsync(userId);
    }
}
