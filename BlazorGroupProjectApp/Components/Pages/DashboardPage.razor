@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject BlazorGroupProjectApp.Services.PredictionService PredictionService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - ClimateSeer</PageTitle>

<h1>Dashboard</h1>

<UserScore />

<div class="dashboard-cards">

    @* Next upcoming prediction *@
    <div class="dashboard-card">
        <h2>Next Upcoming Prediction</h2>
        @if (upcoming == null)
        {
            <p class="card-empty">Loading...</p>
        }
        else if (upcoming.Location == string.Empty)
        {
            <p class="card-empty">No upcoming predictions. <a href="/predictions/new">Make one!</a></p>
        }
        else
        {
            <div class="card-location">@upcoming.Location</div>
            <div class="card-date">@upcoming.TargetDate.ToString("MMMM d, yyyy")</div>
            <div class="card-stats">
                <div>
                    <div class="stat-label">HIGH / LOW</div>
                    <div>@upcoming.PredictedTempHigh°F / @upcoming.PredictedTempLow°F</div>
                </div>
                <div>
                    <div class="stat-label">PRECIP</div>
                    <div>@upcoming.PredictedPrecipitation"</div>
                </div>
                <div>
                    <div class="stat-label">MAX WIND</div>
                    <div>@upcoming.PredictedMaxWindSpeed mph</div>
                </div>
            </div>
            <div class="card-points">Worth up to: @upcoming.PotentialPoints pts</div>
            <a href="/predictions" class="card-link">View all predictions →</a>
        }
    </div>

    @* Most recently scored prediction *@
    <div class="dashboard-card">
        <h2>Latest Result</h2>
        @if (lastScored == null)
        {
            <p class="card-empty">Loading...</p>
        }
        else if (lastScored.Location == string.Empty)
        {
            <p class="card-empty">No scored predictions yet.</p>
        }
        else
        {
            <div class="card-location">@lastScored.Location</div>
            <div class="card-date">@lastScored.TargetDate.ToString("MMMM d, yyyy")</div>
            <div class="card-stats">
                <div>
                    <div class="stat-label">YOUR HIGH / LOW</div>
                    <div>@lastScored.PredictedTempHigh°F / @lastScored.PredictedTempLow°F</div>
                </div>
                <div>
                    <div class="stat-label">ACTUAL HIGH / LOW</div>
                    <div>@lastScored.Result!.ActualTempHigh°F / @lastScored.Result!.ActualTempLow°F</div>
                </div>
            </div>
            <div class="card-points-earned">+@lastScored.Result!.Points pts</div>
            <a href="/predictions" class="card-link">See details →</a>
        }
    </div>

</div>

@code {
    private BlazorGroupProjectApp.Models.Prediction? upcoming;
    private BlazorGroupProjectApp.Models.Prediction? lastScored;

    // Sentinel: non-null but empty Location = "loaded, nothing found"
    private static readonly BlazorGroupProjectApp.Models.Prediction Empty = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId == null) return;

        var all = await PredictionService.GetUserPredictionsAsync(userId);

        upcoming = all.FirstOrDefault(p =>
            p.Status == BlazorGroupProjectApp.Models.PredictionStatus.Pending &&
            p.TargetDate >= DateTime.UtcNow.Date) ?? Empty;

        lastScored = all
            .Where(p => p.Status == BlazorGroupProjectApp.Models.PredictionStatus.Scored && p.Result != null)
            .OrderByDescending(p => p.TargetDate)
            .FirstOrDefault() ?? Empty;
    }
}
