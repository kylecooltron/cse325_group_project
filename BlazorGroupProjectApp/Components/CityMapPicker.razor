    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsReady = true;
            _ref = DotNetObjectReference.Create(this);
            var cityData = Cities.Select(c => new { name = c.Name, lat = c.Lat, lon = c.Lon });
            await JS.InvokeVoidAsync("cityMap.init", mapId, cityData, _ref);
        }
    }

    [JSInvokable]
    public async Task CityClicked(string name, double lat, double lon)
    {
        SelectedCity = name;
        StateHasChanged();
        await OnCitySelected.InvokeAsync(new CitySelection(name, lat, lon));
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsReady)
            await JS.InvokeVoidAsync("cityMap.dispose", mapId);
        _ref?.Dispose();
    }

    private record CityData(string Name, double Lat, double Lon);
}
